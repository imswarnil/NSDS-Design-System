node_modules/

# Generated by `npm run preview`. Not committed: it is a view of the system,
# not part of it, and it is one command away at any time.
preview/

# dist/ IS committed on purpose — the Ghost theme's gulp pipeline consumes the
# flat bundle directly, and `npm run check:css` proves it matches the source.

# Deployable static site — built by `gulp site`, published by CI.
_site/

# The homepage, generated by `gulp build` from preview/pages.json. Served at
# / by the dev server and copied into _site/ by the site build — a view of
# the system, like preview/, and one command away.
/index.html

# Machine-local agent settings — permissions and the like, specific to one
# checkout. .claude/skills/ IS committed: the portable skill bundle is part of
# the system, generated by `gulp build` and gated by `gulp check`.
.claude/settings.local.json

# macOS noise
.DS_Store
